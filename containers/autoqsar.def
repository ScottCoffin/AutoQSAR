Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# AutoQSAR Apptainer definition file
#
# Build:
#   apptainer build autoqsar.sif containers/autoqsar.def
#
# Or, build from a pre-exported Docker tarball (faster on HPC):
#   docker save autoqsar:latest | gzip > autoqsar.tar.gz
#   apptainer build autoqsar.sif docker-archive://autoqsar.tar.gz
#
# Run (GPU):
#   apptainer run --nv \
#     --bind /scratch/autoqsar_in:/in \
#     --bind /scratch/autoqsar_out:/out \
#     autoqsar.sif --dataset tdc_caco2_wang --seed 1 \
#                  --input-dir /in --output-dir /out --device auto
#
# Run (CPU):
#   apptainer run \
#     --bind /scratch/autoqsar_in:/in \
#     --bind /scratch/autoqsar_out:/out \
#     autoqsar.sif --dataset tdc_caco2_wang --seed 1 \
#                  --input-dir /in --output-dir /out --device cpu

%arguments
    GIT_COMMIT=unknown
    GIT_TAG=unknown
    BUILD_DATE=unknown

%labels
    Author "AutoQSAR project"
    CUDA_Version 12.1
    Python_Version 3.11
    Git_Commit {{ GIT_COMMIT }}
    Git_Tag {{ GIT_TAG }}
    Build_Date {{ BUILD_DATE }}
    Container_Type Apptainer/Singularity

%help
    AutoQSAR — portable QSAR modeling and benchmarking (CUDA 12.1).

    Run one (dataset, seed) unit:
      apptainer run --nv autoqsar.sif \
        --dataset <NAME> --seed <INT> \
        --input-dir <path/to/data+model_cache> \
        --output-dir <path/to/results> \
        --device auto

    For CPU-only jobs omit --nv and pass --device cpu.

    See CONTAINER.md in the repo for full usage and HPC submission instructions.

%post
    # ── System packages ───────────────────────────────────────────────────────
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        build-essential \
        git \
        curl \
        wget \
        ca-certificates \
        libssl-dev \
        libffi-dev \
        libgomp1 \
        libxml2-dev \
        zlib1g-dev
    add-apt-repository ppa:deadsnakes/ppa
    apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3.11-venv \
        python3.11-distutils
    rm -rf /var/lib/apt/lists/*

    # ── Python virtual environment ────────────────────────────────────────────
    python3.11 -m venv /opt/venv
    export PATH="/opt/venv/bin:$PATH"
    pip install --no-cache-dir --upgrade pip==24.2 setuptools==70.2.0 wheel==0.46.3

    # ── PyTorch + CUDA 12.1 ───────────────────────────────────────────────────
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu121 \
        torch==2.5.1+cu121 \
        torchvision==0.20.1+cu121 \
        torchaudio==2.5.1+cu121 \
        torchdata==0.9.0

    # ── DGL cu121 ─────────────────────────────────────────────────────────────
    pip install --no-cache-dir \
        dgl==2.2.1 \
        dgllife==0.3.2 \
        -f https://data.dgl.ai/wheels/torch-2.5/cu121/repo.html

    # ── unicore (DeepModeling backbone for Uni-Mol2) ──────────────────────────
    # Requires nvcc (already present in the devel base image used for Apptainer).
    # Operator: if building from cudnn8-runtime base, switch bootstrap to
    # docker://nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04 or install nvcc via
    # apt before this step, then remove nvcc after compilation to save space.
    # TODO (operator): pin UNICORE_GIT_SHA to a specific commit for full
    # reproducibility (matches the ARG in containers/Dockerfile).
    UNICORE_GIT_SHA=e04f7ef73d7685cf0fd1090de87a1b0900ef6f01
    git clone https://github.com/dptech-corp/unicore.git /tmp/unicore
    cd /tmp/unicore && git checkout ${UNICORE_GIT_SHA}
    pip install --no-cache-dir -e /tmp/unicore
    rm -rf /tmp/unicore
    cd /opt/autoqsar

    # ── Remaining pinned requirements ─────────────────────────────────────────
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu121 \
        -r /opt/autoqsar/environment/requirements-lock.txt

    # ── Vendored PyTDC ────────────────────────────────────────────────────────
    pip install --no-cache-dir /opt/autoqsar/.cache/pytdc-1.1.15.tar.gz

    # ── Record installed packages into BUILD_PROVENANCE.md ───────────────────
    echo "" >> /opt/autoqsar/BUILD_PROVENANCE.md
    echo "## Installed packages (pip freeze inside image)" >> /opt/autoqsar/BUILD_PROVENANCE.md
    echo "\`\`\`" >> /opt/autoqsar/BUILD_PROVENANCE.md
    pip freeze >> /opt/autoqsar/BUILD_PROVENANCE.md
    echo "\`\`\`" >> /opt/autoqsar/BUILD_PROVENANCE.md

    # ── Cleanup ───────────────────────────────────────────────────────────────
    apt-get clean
    rm -rf /tmp/* /var/tmp/*

%environment
    export PATH="/opt/venv/bin:$PATH"
    export PYTHONHASHSEED=0
    export PYTHONUNBUFFERED=1
    export CUBLAS_WORKSPACE_CONFIG=":4096:8"
    export OMP_NUM_THREADS=1
    # Bind-mount paths used by Slurm submission script
    export AUTOQSAR_INPUT=/in
    export AUTOQSAR_OUTPUT=/out

%runscript
    exec python /opt/autoqsar/run_one.py "$@"

%files
    # Copy repo source into image (data, benchmark_results, model_cache excluded via .apptainerignore)
    . /opt/autoqsar
